NODE_ENV=development
PORT=4000

# --- Database ---
# Option A (recommended for Render/Supabase/Neon): a single connection string.
# When DATABASE_URL is present, DB_* below are ignored and SSL is enabled by default
# (set DB_SSL=false to disable).
# DATABASE_URL=postgresql://user:password@host:5432/urumuli_pharmacy
# DB_SSL=true

# Option B: individual variables (used when DATABASE_URL is not set).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urumuli_pharmacy
DB_USER=postgres
DB_PASSWORD=change-me
DB_MAX_POOL=20

# --- Redis ---
# Option A: a single connection string, e.g. from Render Redis / Upstash.
# REDIS_URL=rediss://default:password@host:6379
# Option B: individual variables (used when REDIS_URL is not set).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Encryption (for PHI/PII data at rest)
ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
MAX_PRESCRIPTION_FILES=3

# OTP / Payments / Orders
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PROVIDER=development
PAYMENT_PROVIDER=development
ORDER_SIGNING_SECRET=replace-with-an-independent-random-secret
RESERVATION_MINUTES=30

# Google Sign-In (optional, patients only)
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email verification (optional, used for Google sign-in verification links)
# Uses Gmail SMTP with an App Password — see: https://myaccount.google.com/apppasswords
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_APP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=Urumuli Pharmacy <your-gmail@gmail.com>
# EMAIL_VERIFICATION_TTL_MS=86400000
# PUBLIC_URL=http://localhost:5173

# SMS provider: development (mock), africastalking, or twilio
SMS_PROVIDER=development
# AT_API_KEY=
# AT_USERNAME=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
