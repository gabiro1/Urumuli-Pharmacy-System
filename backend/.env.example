NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urumuli_pharmacy
DB_USER=postgres
DB_PASSWORD=change-me
DB_MAX_POOL=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Encryption (for PHI/PII data at rest)
ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
MAX_PRESCRIPTION_FILES=3

# OTP / Payments / Orders
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PROVIDER=development
PAYMENT_PROVIDER=development
ORDER_SIGNING_SECRET=replace-with-an-independent-random-secret
RESERVATION_MINUTES=30
